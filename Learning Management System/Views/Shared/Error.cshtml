@model ErrorViewModel
@{
    ViewData["Title"] = "Error " + Model?.StatusCode;
}

<div class="text-center mt-5">
    <h1 class="text-danger">@Model?.StatusCode</h1>
    <h2>@Model?.Message</h2>
    <p class="mt-3">
        <a href="/" class="btn btn-primary">Return to Home</a>
    </p>

    @if (Model?.ShowRequestId == true)
    {
        <p class="text-muted mt-4"><small>Request ID: @Model.RequestId</small></p>
    }
</div>
