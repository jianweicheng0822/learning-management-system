{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=LMS;User=root;Password=REPLACE_WITH_USER_SECRETS;"
  },
  "AWS": {
    "S3": {
      "BucketName": "lms-submissions",
      "Region": "us-east-1"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lms-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
